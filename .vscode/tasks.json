// Builds the extension for the "Launch Extension" configuration.
//
// This was in the pre-2.0.0 shorthand -- a top level "command"/"args" and no
// tasks array, so the task had no label and was referred to by its command
// name. It also still passed webpack's --display flag and matched problems with
// webpack's output format, neither of which has existed here since the bundler
// became esbuild.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bundle: watch",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "presentation": {
        "reveal": "silent"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      // esbuild does not type check, so its output carries resolution and
      // syntax errors only -- and it prints those across non-consecutive lines,
      // which a problem matcher pattern cannot follow. Diagnostics come from
      // "typecheck: watch" below; this one only has to tell the launch when a
      // build is done. The patterns are the ones scripts/build.mjs actually
      // emits.
      "problemMatcher": {
        "pattern": {
          "regexp": "^\\[watch\\] build (started|finished)",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      }
    },
    {
      "label": "typecheck: watch",
      "type": "shell",
      "command": "npx tsc --noEmit --watch",
      "isBackground": true,
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$tsc-watch"
    }
  ]
}
