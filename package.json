{
  "name": "syncx",
  "displayName": "SyncX – SFTP & FTP Sync",
  "description": "SFTP/FTP sync for VS Code, with change detection that does not re-upload files that did not change.",
  "version": "1.0.0",
  "publisher": "kr-ilya",
  "author": "kr-ilya (https://github.com/kr-ilya)",
  "engines": {
    "vscode": "^1.90.0"
  },
  "bugs": {
    "url": "https://github.com/kr-ilya/vscode-sftp/issues"
  },
  "homepage": "https://github.com/kr-ilya/vscode-sftp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kr-ilya/vscode-sftp.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "sftp",
    "ftp",
    "sync",
    "remote",
    "upload-on-save",
    "deploy"
  ],
  "activationEvents": [
    "onCommand:syncx.config",
    "workspaceContains:.vscode/sftp.json"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "syncx",
          "title": "SyncX",
          "icon": "resources/remote-explorer.svg"
        }
      ]
    },
    "views": {
      "syncx": [
        {
          "id": "syncx.remoteExplorer",
          "name": "Explorer",
          "when": "syncx.enabled"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "SyncX",
      "properties": {
        "syncx.printDebugLog": {
          "type": "boolean",
          "default": false,
          "description": "print debug log on SyncX output channel.(reload vscode when change this)"
        },
        "syncx.debug": {
          "type": "boolean",
          "default": false,
          "description": "print debug log on SyncX output channel.(reload vscode when change this)"
        },
        "syncx.downloadWhenOpenInRemoteExplorer": {
          "type": "boolean",
          "default": false,
          "description": "\"Download\" instead of \"View Content\" when open file in Remote Explorer"
        }
      }
    },
    "commands": [
      {
        "command": "syncx.config",
        "title": "Config",
        "category": "SyncX"
      },
      {
        "command": "syncx.setProfile",
        "title": "Set Profile",
        "category": "SyncX"
      },
      {
        "command": "syncx.openConnectInTerminal",
        "title": "Open SSH in Terminal",
        "category": "SyncX"
      },
      {
        "command": "syncx.cancelAllTransfer",
        "title": "Cancel All Transfers",
        "category": "SyncX"
      },
      {
        "command": "syncx.upload.file",
        "title": "Upload File",
        "category": "SyncX"
      },
      {
        "command": "syncx.upload.changedFiles",
        "title": "Upload Changed Files",
        "category": "SyncX",
        "icon": {
          "light": "resources/light/upload.svg",
          "dark": "resources/dark/upload.svg"
        }
      },
      {
        "command": "syncx.upload.activeFile",
        "title": "Upload Active File",
        "category": "SyncX"
      },
      {
        "command": "syncx.upload.folder",
        "title": "Upload Folder",
        "category": "SyncX"
      },
      {
        "command": "syncx.upload.activeFolder",
        "title": "Upload Active Folder",
        "category": "SyncX"
      },
      {
        "command": "syncx.upload.project",
        "title": "Upload Project",
        "category": "SyncX"
      },
      {
        "command": "syncx.forceUpload",
        "title": "Force Upload",
        "category": "SyncX"
      },
      {
        "command": "syncx.upload.file.to.allProfiles",
        "title": "Upload File To All Profiles",
        "category": "SyncX"
      },
      {
        "command": "syncx.upload.activeFile.to.allProfiles",
        "title": "Upload Active File To All Profiles",
        "category": "SyncX"
      },
      {
        "command": "syncx.upload.folder.to.allProfiles",
        "title": "Upload Folder To All Profiles",
        "category": "SyncX"
      },
      {
        "command": "syncx.upload.activeFolder.to.allProfiles",
        "title": "Upload Active Folder To All Profiles",
        "category": "SyncX"
      },
      {
        "command": "syncx.upload.project.to.allProfiles",
        "title": "Upload Project To All Profiles",
        "category": "SyncX"
      },
      {
        "command": "syncx.forceUpload.to.allProfiles",
        "title": "Force Upload To All Profiles",
        "category": "SyncX"
      },
      {
        "command": "syncx.download.file",
        "title": "Download File",
        "category": "SyncX",
        "icon": {
          "dark": "resources/dark/download-file.svg",
          "light": "resources/light/download-file.svg"
        }
      },
      {
        "command": "syncx.download.activeFile",
        "title": "Download Active File",
        "category": "SyncX"
      },
      {
        "command": "syncx.download.folder",
        "title": "Download Folder",
        "category": "SyncX",
        "icon": {
          "dark": "resources/dark/download-folder.svg",
          "light": "resources/light/download-folder.svg"
        }
      },
      {
        "command": "syncx.download.activeFolder",
        "title": "Download Active Folder",
        "category": "SyncX"
      },
      {
        "command": "syncx.download.project",
        "title": "Download Project",
        "category": "SyncX"
      },
      {
        "command": "syncx.forceDownload",
        "title": "Force Download",
        "category": "SyncX"
      },
      {
        "command": "syncx.sync.localToRemote",
        "title": "Sync Local -> Remote",
        "category": "SyncX"
      },
      {
        "command": "syncx.sync.remoteToLocal",
        "title": "Sync Remote -> Local",
        "category": "SyncX"
      },
      {
        "command": "syncx.sync.bothDirections",
        "title": "Sync Both Directions",
        "category": "SyncX"
      },
      {
        "command": "syncx.diff",
        "title": "Diff with Remote",
        "category": "SyncX"
      },
      {
        "command": "syncx.diff.activeFile",
        "title": "Diff Active File with Remote",
        "category": "SyncX"
      },
      {
        "command": "syncx.list",
        "title": "List",
        "category": "SyncX"
      },
      {
        "command": "syncx.listActiveFolder",
        "title": "List Active Folder",
        "category": "SyncX"
      },
      {
        "command": "syncx.listAll",
        "title": "List All",
        "category": "SyncX"
      },
      {
        "command": "syncx.delete.remote",
        "title": "Delete",
        "category": "SyncX"
      },
      {
        "command": "syncx.create.folder",
        "title": "Create Folder",
        "category": "SyncX"
      },
      {
        "command": "syncx.create.file",
        "title": "Create File",
        "category": "SyncX"
      },
      {
        "command": "syncx.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "SyncX"
      },
      {
        "command": "syncx.revealInRemoteExplorer",
        "title": "Reveal in Remote Explorer",
        "category": "SyncX"
      },
      {
        "command": "syncx.remoteExplorer.editInLocal",
        "title": "Edit in Local",
        "category": "SyncX"
      },
      {
        "command": "syncx.viewContent",
        "title": "View Content",
        "category": "SyncX"
      },
      {
        "command": "syncx.remoteExplorer.refresh",
        "title": "Refresh",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "syncx.remoteExplorer.refreshActiveFile",
        "title": "Refresh Active Remote File",
        "category": "SyncX",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "syncx.watch.diagnostics",
        "title": "Show Change Detection Diagnostics",
        "category": "SyncX"
      },
      {
        "command": "syncx.watch.dryRun",
        "title": "Dry Run: Show What Would Be Uploaded",
        "category": "SyncX"
      },
      {
        "command": "syncx.forgetPassword",
        "title": "Forget Saved Password",
        "category": "SyncX"
      },
      {
        "command": "syncx.resetRemotePathApprovals",
        "title": "Reset Confirmed Upload Destinations",
        "category": "SyncX"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "syncx.setProfile",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.openConnectInTerminal",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.cancelAllTransfer",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.upload.activeFile",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.upload.activeFolder",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.upload.project",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.upload.activeFile.to.allProfiles",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.upload.activeFolder.to.allProfiles",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.upload.project.to.allProfiles",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.download.activeFile",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.download.activeFolder",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.download.project",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.sync.localToRemote",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.sync.remoteToLocal",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.sync.bothDirections",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.diff.activeFile",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.list",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.listActiveFolder",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.listAll",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.upload.file",
          "when": "false"
        },
        {
          "command": "syncx.upload.changedFiles",
          "when": "syncx.enabled"
        },
        {
          "command": "syncx.upload.folder",
          "when": "false"
        },
        {
          "command": "syncx.forceUpload",
          "when": "false"
        },
        {
          "command": "syncx.upload.file.to.allProfiles",
          "when": "false"
        },
        {
          "command": "syncx.upload.folder.to.allProfiles",
          "when": "false"
        },
        {
          "command": "syncx.forceUpload.to.allProfiles",
          "when": "false"
        },
        {
          "command": "syncx.download.file",
          "when": "false"
        },
        {
          "command": "syncx.download.folder",
          "when": "false"
        },
        {
          "command": "syncx.forceDownload",
          "when": "false"
        },
        {
          "command": "syncx.diff",
          "when": "false"
        },
        {
          "command": "syncx.delete.remote",
          "when": "false"
        },
        {
          "command": "syncx.create.folder",
          "when": "false"
        },
        {
          "command": "syncx.create.file",
          "when": "false"
        },
        {
          "command": "syncx.revealInExplorer",
          "when": "false"
        },
        {
          "command": "syncx.revealInRemoteExplorer",
          "when": "false"
        },
        {
          "command": "syncx.remoteExplorer.editInLocal",
          "when": "false"
        },
        {
          "command": "syncx.viewContent",
          "when": "false"
        },
        {
          "command": "syncx.remoteExplorer.refresh",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "syncx.revealInRemoteExplorer",
          "group": "navigation@20",
          "when": "syncx.enabled && !explorerResourceIsRoot"
        },
        {
          "command": "syncx.diff",
          "group": "3_compare",
          "when": "syncx.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "syncx.sync.localToRemote",
          "group": "syncx.sync@1",
          "when": "syncx.enabled && explorerResourceIsFolder"
        },
        {
          "command": "syncx.sync.remoteToLocal",
          "group": "syncx.sync@2",
          "when": "syncx.enabled && explorerResourceIsFolder"
        },
        {
          "command": "syncx.sync.bothDirections",
          "group": "syncx.sync@3",
          "when": "syncx.enabled && explorerResourceIsFolder"
        },
        {
          "command": "syncx.upload.file",
          "group": "syncx.trans@1",
          "when": "syncx.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "syncx.upload.folder",
          "group": "syncx.trans@1",
          "alt": "syncx.forceUpload",
          "when": "syncx.enabled && explorerResourceIsFolder"
        },
        {
          "command": "syncx.upload.file.to.allProfiles",
          "group": "syncx.trans@1",
          "when": "syncx.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "syncx.upload.folder.to.allProfiles",
          "group": "syncx.trans@1",
          "alt": "syncx.forceUpload.to.allProfiles",
          "when": "syncx.enabled && explorerResourceIsFolder"
        },
        {
          "command": "syncx.download.file",
          "group": "syncx.trans@2",
          "when": "syncx.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "syncx.download.folder",
          "group": "syncx.trans@2",
          "alt": "syncx.forceDownload",
          "when": "syncx.enabled && explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "syncx.upload.file",
          "group": "syncx.trans@1",
          "when": "syncx.enabled && resourceScheme == file"
        },
        {
          "command": "syncx.upload.file.to.allProfiles",
          "group": "syncx.trans@1",
          "when": "syncx.enabled && resourceScheme == file"
        },
        {
          "command": "syncx.download.file",
          "group": "syncx.trans@2",
          "when": "syncx.enabled && resourceScheme == file"
        },
        {
          "command": "syncx.diff",
          "group": "3_compare",
          "when": "syncx.enabled && resourceScheme == file"
        },
        {
          "command": "syncx.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "syncx.enabled && resourceScheme == syncx"
        }
      ],
      "editor/title": [
        {
          "command": "syncx.remoteExplorer.refreshActiveFile",
          "group": "navigation",
          "when": "syncx.enabled && resourceScheme == syncx"
        }
      ],
      "editor/title/context": [
        {
          "command": "syncx.revealInExplorer",
          "group": "2_files",
          "when": "syncx.enabled && resourceScheme == syncx"
        },
        {
          "command": "syncx.revealInRemoteExplorer",
          "when": "syncx.enabled && resourceScheme == file",
          "group": "2_files"
        }
      ],
      "view/title": [
        {
          "command": "syncx.remoteExplorer.refresh",
          "when": "view == syncx.remoteExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "syncx.openConnectInTerminal",
          "group": "navigation",
          "when": "view == syncx.remoteExplorer && viewItem == root"
        },
        {
          "command": "syncx.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "view == syncx.remoteExplorer && viewItem == file && !config.syncx.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "syncx.viewContent",
          "group": "2_files",
          "when": "view == syncx.remoteExplorer && viewItem == file && config.syncx.downloadWhenOpenInRemoteExplorer"
        },
        {
          "command": "syncx.revealInExplorer",
          "group": "2_files",
          "when": "view == syncx.remoteExplorer && viewItem != root"
        },
        {
          "command": "syncx.upload.folder",
          "group": "3_trans@1",
          "alt": "syncx.forceUpload",
          "when": "syncx.enabled && viewItem != file"
        },
        {
          "command": "syncx.upload.file",
          "group": "3_trans@1",
          "when": "view == syncx.remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "syncx.upload.folder.to.allProfiles",
          "group": "3_trans@1",
          "alt": "syncx.forceUpload.to.allProfiles",
          "when": "syncx.enabled && viewItem != file"
        },
        {
          "command": "syncx.upload.file.to.allProfiles",
          "group": "3_trans@1",
          "when": "view == syncx.remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "syncx.download.folder",
          "group": "3_trans@2",
          "alt": "syncx.forceDownload",
          "when": "syncx.enabled && viewItem != file"
        },
        {
          "command": "syncx.download.file",
          "group": "3_trans@2",
          "when": "view == syncx.remoteExplorer && viewItem != root && viewItem == file"
        },
        {
          "command": "syncx.delete.remote",
          "group": "7_modification",
          "when": "view == syncx.remoteExplorer && viewItem != root"
        },
        {
          "command": "syncx.create.folder",
          "group": "7_modification",
          "when": "view == syncx.remoteExplorer && viewItem != file"
        },
        {
          "command": "syncx.create.file",
          "group": "7_modification",
          "when": "view == syncx.remoteExplorer && viewItem != file"
        },
        {
          "command": "syncx.download.file",
          "group": "inline",
          "when": "view == syncx.remoteExplorer && viewItem == file"
        },
        {
          "command": "syncx.download.folder",
          "group": "inline",
          "when": "syncx.enabled && view == syncx.remoteExplorer && viewItem == folder"
        }
      ],
      "scm/title": [
        {
          "command": "syncx.upload.changedFiles",
          "group": "syncx",
          "when": "syncx.enabled && scmProvider == git && !gitFreshRepository"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "syncx.upload.changedFiles",
          "group": "inline",
          "when": "syncx.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "syncx.upload.changedFiles",
          "group": "syncx",
          "when": "syncx.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "syncx.upload.changedFiles",
          "group": "inline",
          "when": "syncx.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        },
        {
          "command": "syncx.upload.changedFiles",
          "group": "syncx",
          "when": "syncx.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        }
      ]
    },
    "keybindings": [
      {
        "command": "syncx.upload.changedFiles",
        "key": "ctrl+alt+u",
        "when": "syncx.enabled"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/sftp.json",
        "url": "./schema/config.schema.json"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "syncx",
        "formatting": {
          "label": "${path}",
          "separator": "/"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/build.mjs --production",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "vsce package",
    "smoke": "node scripts/smoke.mjs",
    "gen:schema": "node scripts/gen-schema.mjs",
    "gen:schema:check": "node scripts/gen-schema.mjs --check",
    "check:core": "node scripts/check-core-purity.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.4.1",
    "memfs": "^4.57.7",
    "ovsx": "^1.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "basic-ftp": "^6.2.1",
    "fs-extra": "^11.4.0",
    "ignore": "^7.0.9",
    "jsonc-parser": "^3.3.1",
    "lru-cache": "^11.5.2",
    "ssh-config": "^5.2.1",
    "ssh2": "^1.17.0",
    "tmp": "^0.2.7",
    "upath": "^3.0.8",
    "vscode-uri": "^3.2.0",
    "zod": "^4.6.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  }
}
